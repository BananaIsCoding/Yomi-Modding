	$\"%Dust4\".start_emitting() 

func _frame_105():
	$\"%Dust2\".stop_emitting()
	$\"%Dust4\".stop_emitting() 

func _frame_90():
	$\"%Awaken\".hide()



func _frame_20():
	$\"%Dash\".stop_emitting() 

func _exit():
	$\"%Dash\".stop_emitting() 
"

