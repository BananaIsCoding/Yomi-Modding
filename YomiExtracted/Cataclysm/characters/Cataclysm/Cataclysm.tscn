	host.spawn_particle_effect_relative(load(\"res://Cataclysm/characters/Cataclysm/Dust6.tscn\"), Vector2(0, 0), Vector2(data.x, data.y))
	if data:
		var dir= xy_to_dir(data.x, data.y, \"200\")
		host.move_directly(dir.x, dir.y)
	if data:
		var dir= xy_to_dir(data.x, data.y, \"6\")
		host.apply_force(dir.x, dir.y)
	$\"%Dust4\".start_emitting()

func _frame_5():
	$\"%Dust4\".stop_emitting()

func _exit():
	$\"%Dust4\".stop_emitting()
"

[sub_resource type="GDScript" id=369]
script/source = "extends CharacterState

onready var Rain = load(\"res://Cataclysm/characters/Cataclysm/Rain.tscn\")
onready var Splash = load(\"res://Cataclysm/characters/Cataclysm/Splash.tscn\")

func _frame_0():
	host.opponent.hitlag_ticks += 120
	host.set_camera_zoom(0.50)
	host.tween_camera_zoom(0.99, 0.50, 0.65, Tween.TRANS_QUART, Tween.EASE_OUT)
	$\"%Dust3\".start_emitting() 
	host.play_sound(\"Sound\")
	
func _frame_1():
	$\"%Dust3\".stop_emitting() 

func _frame_55():
	$\"%Dust\".start_emitting() 
	host.set_camera_zoom(0.70)
	host.tween_camera_zoom(0.50, 0.70, 0.65, Tween.TRANS_QUART, Tween.EASE_OUT)
	host.spawn_particle_effect(Splash, Vector2.ZERO)
	host.spawn_particle_effect(Rain, Vector2.ZERO)
	host.play_sound(\"Rain\")

func _frame_65():
	$\"%Dust\".stop_emitting() 
	
func _frame_74():
