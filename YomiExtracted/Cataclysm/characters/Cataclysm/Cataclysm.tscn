[sub_resource type="GDScript" id=498]
script/source = "extends CharacterState

onready var Ulti = load(\"res://Cataclysm/characters/Cataclysm/Ulti.tscn\")
onready var Ultidust = load(\"res://Cataclysm/characters/Cataclysm/Ultidust.tscn\")
onready var Rain = load(\"res://Cataclysm/characters/Cataclysm/Rain.tscn\")
onready var Splash = load(\"res://Cataclysm/characters/Cataclysm/Splash.tscn\")

func _frame_0():
	host.opponent.hitlag_ticks += 40
	host.set_camera_zoom(0.50)
	host.tween_camera_zoom(0.99, 0.50, 0.65, Tween.TRANS_QUART, Tween.EASE_OUT)
	host.play_sound(\"SwordSwush\")
	host.play_sound(\"SwordSwush2\")

func _frame_40():
	host.play_sound(\"SwordSpin\")
	host.play_sound(\"SwordCharge\")
	host.set_camera_zoom(0.30)
	host.tween_camera_zoom(0.50, 0.30, 0.65, Tween.TRANS_QUART, Tween.EASE_OUT)

func _frame_52():
	host.spawn_particle_effect_relative(load(\"res://Cataclysm/characters/Cataclysm/Ulti.tscn\"), Vector2(0, 0), Vector2(0, 0))
	host.spawn_particle_effect_relative(load(\"res://Cataclysm/characters/Cataclysm/Ultidust.tscn\"), Vector2(0, 0), Vector2(0, 0))
	host.play_sound(\"SwordImpact\")
	host.set_camera_zoom(1.0)
	host.tween_camera_zoom(0.20, 1.0, 0.65, Tween.TRANS_QUART, Tween.EASE_OUT)
	host.spawn_particle_effect(Splash, Vector2.ZERO)
	host.spawn_particle_effect(Rain, Vector2.ZERO)
	host.play_sound(\"Rain\")

func is_usable():
	return .is_usable() and host.bloodfeast > 40

func _frame_5():
	host.bloodfeast -= 40
"

[sub_resource type="GDScript" id=452]
script/source = "extends CharacterState

func _frame_1():
	if data:
		var dir= xy_to_dir(data.x, data.y, \"15\")
		host.apply_force(dir.x, dir.y)

func _on_hit_something(obj, hitbox):
	._on_hit_something(obj, hitbox)
	if obj == host.get_opponent():
		host.bloodfeast += 10

func _exit():
	if host.bloodfeast > 40:
		$\"%bloodfeast\".start_emitting()
	if host.bloodfeast < 40:
		$\"%bloodfeast\".stop_emitting()
"

